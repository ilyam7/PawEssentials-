<section class="section">
  <div class="container">
    <div class="section__head">
      <h1>{{ 'collections.general.title' | t | default: 'All collections' }}</h1>
    </div>
    <div class="product-grid">
      {%- for collection in collections -%}
        <a href="{{ collection.url }}" class="product-card">
          <div class="product-card__media">
            {%- if collection.image -%}
              {{ collection.image | image_url: width: 600 | image_tag: alt: collection.title }}
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag }}
            {%- endif -%}
          </div>
          <div class="product-card__body">
            <h3 class="product-card__title">{{ collection.title }}</h3>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "List collections",
  "settings": []
}
{% endschema %}
