<section class="section trust">
  <div class="container">
    <div class="section__head">
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p>{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <div class="trust__grid">
      {%- for block in section.blocks -%}
        <div class="trust__item" {{ block.shopify_attributes }}>
          <span class="trust__icon" aria-hidden="true">{{ block.settings.icon }}</span>
          <h3 class="trust__title">{{ block.settings.title }}</h3>
          <p class="trust__desc">{{ block.settings.description }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Trust badges",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why pet parents choose PawEssentials"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Quality you can feel, service you can count on."
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon (emoji)", "default": "🚚" },
        { "type": "text", "id": "title", "label": "Title", "default": "Free shipping $40+" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Fast, tracked delivery on every qualifying order — no surprises at checkout." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust badges",
      "blocks": [
        { "type": "badge", "settings": { "icon": "🚚", "title": "Free shipping $40+", "description": "Fast, tracked delivery on every qualifying order." } },
        { "type": "badge", "settings": { "icon": "↩️", "title": "30-day returns", "description": "Not the right fit? Send it back, hassle-free." } },
        { "type": "badge", "settings": { "icon": "🐾", "title": "Pet-parent tested", "description": "Every product is vetted by real owners with real pets." } },
        { "type": "badge", "settings": { "icon": "🔒", "title": "Secure checkout", "description": "Encrypted payments and buyer protection on every order." } }
      ]
    }
  ]
}
{% endschema %}
